#include <stdio.h>
#include <stdlib.h>

int main() {
    int n,f,h,am,sm,i,j,start=-1,a[100]={0};
    int b[100],v[100]={0},t=0,min,p,k;

    printf("Enter disk size, file size and head: ");
    scanf("%d%d%d",&n,&f,&h);

    printf("1.Contiguous  2.Indexed: ");
    scanf("%d",&am);

    printf("1.FCFS  2.SSTF: ");
    scanf("%d",&sm);

    /* Allocation */
    if(am==1) {
        for(i=0;i<=n-f;i++) {
            for(j=0;j<f && a[i+j]==0;j++);
            if(j==f) {
                start=i;
                break;
            }
        }

        if(start==-1) {
            printf("Allocation failed");
            return 0;
        }

        for(i=0;i<f;i++)
            b[i]=start+i;
    }
    else {
        a[0]=1;
        for(i=0;i<f;i++) {
            b[i]=i+1;
            a[i+1]=1;
        }
    }

    printf("\nAllocated blocks: ");
    for(i=0;i<f;i++) printf("%d ",b[i]);

    /* Scheduling */
    printf("\nSeek sequence: %d ",h);

    if(sm==1) {
        for(i=0;i<f;i++) {
            t+=abs(h-b[i]);
            h=b[i];
            printf("-> %d ",h);
        }
    }
    else {
        for(k=0;k<f;k++) {
            min=9999;
            p=-1;

            for(i=0;i<f;i++)
                if(!v[i] && abs(h-b[i])<min) {
                    min=abs(h-b[i]);
                    p=i;
                }

            v[p]=1;
            t+=abs(h-b[p]);
            h=b[p];

            printf("-> %d ",h);
        }
    }

    printf("\nTotal Seek Time = %d",t);

    return 0;
}

