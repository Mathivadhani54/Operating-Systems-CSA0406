#include <stdio.h>
#include <stdlib.h>

void fcfs(int a[],int n,int h) {
    int i,t=0;
    printf("\nFCFS: %d ",h);
    for(i=0;i<n;i++) {
        t+=abs(h-a[i]);
        h=a[i];
        printf("-> %d ",h);
    }
    printf("\nSeek Time = %d\n",t);
}

void sstf(int a[],int n,int h) {
    int v[100]={0},i,k,min,p,t=0;
    printf("\nSSTF: %d ",h);

    for(k=0;k<n;k++) {
        min=9999;p=-1;
        for(i=0;i<n;i++)
            if(!v[i] && abs(h-a[i])<min) {
                min=abs(h-a[i]);
                p=i;
            }
        v[p]=1;
        t+=abs(h-a[p]);
        h=a[p];
        printf("-> %d ",h);
    }
    printf("\nSeek Time = %d\n",t);
}

void scan(int a[],int n,int h) {
    int i,j,t=0,temp;

    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(a[i]>a[j]) {
                temp=a[i]; a[i]=a[j]; a[j]=temp;
            }

    printf("\nSCAN: %d ",h);

    for(i=n-1;i>=0;i--)
        if(a[i]<h) {
            t+=abs(h-a[i]);
            h=a[i];
            printf("-> %d ",h);
        }

    t+=h;
    h=0;
    printf("-> 0 ");

    for(i=0;i<n;i++)
        if(a[i]>h) {
            t+=abs(h-a[i]);
            h=a[i];
            printf("-> %d ",h);
        }

    printf("\nSeek Time = %d\n",t);
}

int main() {
    int a[100],n,h,i;

    printf("Enter number of requests: ");
    scanf("%d",&n);

    printf("Enter requests: ");
    for(i=0;i<n;i++) scanf("%d",&a[i]);

    printf("Enter head: ");
    scanf("%d",&h);

    fcfs(a,n,h);
    sstf(a,n,h);
    scan(a,n,h);

    return 0;
}

