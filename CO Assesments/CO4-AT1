#include <stdio.h>
#include <stdlib.h>

void sort(int a[],int n) {
    int i,j,t;
    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(a[i]>a[j]) {
                t=a[i]; a[i]=a[j]; a[j]=t;
            }
}

void cscan(int a[],int n,int h,int size) {
    int i,t=0;

    printf("\nC-SCAN: %d ",h);

    for(i=0;i<n;i++)
        if(a[i]>=h) {
            t+=abs(h-a[i]);
            h=a[i];
            printf("-> %d ",h);
        }

    t+=size-1-h;
    h=size-1;
    printf("-> %d -> 0 ",h);

    t+=size-1;
    h=0;

    for(i=0;i<n;i++)
        if(a[i]<h+size-1) {
            t+=abs(h-a[i]);
            h=a[i];
            printf("-> %d ",h);
        }

    printf("\nMovement = %d\n",t);
}

void look(int a[],int n,int h) {
    int i,t=0;

    printf("\nLOOK: %d ",h);

    for(i=0;i<n;i++)
        if(a[i]>=h) {
            t+=abs(h-a[i]);
            h=a[i];
            printf("-> %d ",h);
        }

    for(i=n-1;i>=0;i--)
        if(a[i]<h) {
            t+=abs(h-a[i]);
            h=a[i];
            printf("-> %d ",h);
        }

    printf("\nMovement = %d\n",t);
}

int main() {
    int a[100],n,h,size,i;

    printf("Enter number of requests: ");
    scanf("%d",&n);

    printf("Enter requests: ");
    for(i=0;i<n;i++) scanf("%d",&a[i]);

    printf("Enter head and disk size: ");
    scanf("%d%d",&h,&size);

    sort(a,n);

    cscan(a,n,h,size);
    look(a,n,h);

    return 0;
}

