            b[i]=1;
            count++;
        }

    if(count<req)
        printf("Allocation failed\n");
    else {
        printf("Bitmap after allocation: ");
        for(i=0;i<n;i++) printf("%d ",b[i]);
    }

    printf("\nEnter number of blocks to deallocate: ");
    scanf("%d",&d);

    printf("Enter block numbers: ");
    for(i=0;i<d;i++) {
        scanf("%d",&x);
        if(x>=0 && x<n) b[x]=0;
    }

    printf("Final bitmap: ");
    for(i=0;i<n;i++) printf("%d ",b[i]);

    return 0;
}

